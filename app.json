{
  "expo": {
    "name": "TRIO",
    "slug": "trio",
    "scheme": "trio",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/trio-logo.png",

    "userInterfaceStyle": "light",

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "bundleIdentifier": "com.hasanaydinoglu.trio",
      "icon": "./assets/trio-logo.png",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.hasanaydinoglu.trio",
      "icon": "./assets/trio-logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/trio-logo.png",
        "backgroundColor": "#01040B"
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#01040B",
          "image": "./assets/transparent-splash.png",
          "imageWidth": 100,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TRIO accesses your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],

    "extra": {
      "eas": {
        "projectId": "0cfcb8eb-e263-4553-8fee-82028477c406"
      }
    },

    "owner": "trio-games"
  }
}